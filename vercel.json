{
  "version": 2,
  "functions": {
    "server/server.js": {
      "includeFiles": "client/dist/**",
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/webhooks",
      "destination": "/server/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server/server.js"
    }
  ]
}
