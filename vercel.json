{
  "version": 2,
  "builds": [
    {
      "src": "server/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "server/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/api/index.js" },
    { "src": "/webhooks", "dest": "server/api/index.js" },
    { "src": "/dist/(.*)", "dest": "/dist/$1" },
    { "src": "/(.*)", "dest": "server/api/index.js" }
  ]
}
