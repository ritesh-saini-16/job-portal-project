{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "api/handler.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "config/**", "controllers/**", "middleware/**", "models/**", "routes/**", "utils/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/handler.js"
    },
    {
      "src": "/webhooks",
      "dest": "api/handler.js"
    },
    {
      "src": "/.*",
      "dest": "api/handler.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "true"
  }
}

