{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "config/**",
          "controllers/**",
          "middleware/**",
          "models/**",
          "routes/**",
          "utils/**",
          "uploads/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/webhooks", "dest": "api/index.js" },
    { "src": "/dist/(.*)", "dest": "/dist/$1" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
